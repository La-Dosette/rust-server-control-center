                                        <StackPanel Grid.Column="2"><TextBlock Text="ÉTAPE EN COURS" Foreground="#80776E" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="OperationActiveStageText" Text="Préparation..." FontSize="14" Margin="0,5,16,0" TextTrimming="CharacterEllipsis"/></StackPanel>
