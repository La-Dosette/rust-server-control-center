                                        <StackPanel>
                                            <TextBlock Text="PORTAILS" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock Text="Pose un chiffre sur la grille, puis choisis le mode qu'il ouvre. Un mode dont le plugin est désactivé n'aura pas de portail." Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,10"/>
                                            <StackPanel x:Name="LobbyPortalPanel"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <Border Style="{StaticResource Panel}" Margin="0,16,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="APERÇU 3D" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock x:Name="LobbyPreviewInfoText" Text="Glisse pour tourner, molette pour zoomer." Style="{StaticResource Muted}" Margin="0,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button x:Name="LobbyPreviewResetButton" Grid.Column="1" Content="RECENTRER" Style="{StaticResource SmallButton}" VerticalAlignment="Top"/>
                                    </Grid>
                                    <!-- L'hote porte un fond : un Viewport3D ne recoit la souris que
                                         sur ses formes, pas dans le vide entre elles. -->
                                    <Border x:Name="LobbyViewportHost" Background="#0B0A09" BorderBrush="#302C27" BorderThickness="1" Margin="0,12,0,0" Height="400" ClipToBounds="True" Cursor="SizeAll">
                                        <Viewport3D>
                                            <Viewport3D.Camera>
                                                <PerspectiveCamera x:Name="LobbyCamera" FieldOfView="50" Position="40,40,40" LookDirection="-1,-1,-1" UpDirection="0,1,0" NearPlaneDistance="0.5" FarPlaneDistance="3000"/>
                                            </Viewport3D.Camera>
                                            <ModelVisual3D>
                                                <ModelVisual3D.Content>
                                                    <Model3DGroup>
                                                        <AmbientLight Color="#5A5650"/>
                                                        <DirectionalLight Color="#FFF3E2" Direction="-0.6,-1,-0.4"/>
                                                        <DirectionalLight Color="#5E6672" Direction="0.5,-0.3,0.8"/>
                                                    </Model3DGroup>
                                                </ModelVisual3D.Content>
                                            </ModelVisual3D>
                                            <ModelVisual3D x:Name="LobbyModelVisual"/>
                                        </Viewport3D>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>
            </DockPanel>
        </Grid>

        <Border Grid.Row="3" Background="#171411" BorderBrush="#332D27" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0">
                <TextBlock x:Name="FooterVersionText" Text="CONTROL CENTER v12.1.0" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#71685E"/>
                <TextBlock x:Name="ActivityText" Text="Prêt." VerticalAlignment="Center" Foreground="#AFA69A" TextTrimming="CharacterEllipsis"/>
            </DockPanel>
        </Border>
    </Grid>
</Window>
