                            </Grid>
                            <Border Style="{StaticResource Panel}" Margin="0,14,0,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="SERVICE EN ARRIÈRE-PLAN" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="RemoteServiceStatusText" Text="NON INSTALLÉ" Foreground="#AFA69A" Margin="0,5,0,0"/></StackPanel><WrapPanel Grid.Column="1" VerticalAlignment="Center"><Button x:Name="RemoteStartServiceButton" Content="INSTALLER &amp; DÉMARRER" Style="{StaticResource AmberButton}" Margin="0,0,8,0"/><Button x:Name="RemoteStopServiceButton" Content="ARRÊTER &amp; RETIRER" Style="{StaticResource DangerButton}"/></WrapPanel></Grid></Border>
                            <Border Style="{StaticResource Panel}" Margin="0,14,0,0" Padding="0"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock Text="SERVEURS EXPOSÉS AU TABLEAU DE BORD" Style="{StaticResource SectionTitle}" Margin="18,14"/><DataGrid x:Name="RemoteInstanceGrid" Grid.Row="1" Height="220" AutoGenerateColumns="False" BorderThickness="0,1,0,0"><DataGrid.Columns><DataGridTextColumn Header="SERVEUR" Binding="{Binding DisplayName}" Width="*"/><DataGridTextColumn Header="ÉTAT" Binding="{Binding State}" Width="100"/><DataGridTextColumn Header="PORT" Binding="{Binding Port}" Width="90"/><DataGridTextColumn Header="ISOLATION" Binding="{Binding Isolation}" Width="170"/></DataGrid.Columns></DataGrid></Grid></Border>
