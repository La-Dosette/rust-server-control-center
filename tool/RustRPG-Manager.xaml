                                        <CheckBox x:Name="WizardAutoPortsCheck" Content="Attribuer automatiquement un bloc de ports libres" IsChecked="True" Margin="0,0,0,15" Style="{StaticResource WizardCheck}"/>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                            <StackPanel><TextBlock Text="PORT JEU (UDP)" Foreground="#B9AEA2" FontSize="11" FontWeight="Bold"/><TextBox x:Name="WizardServerPortBox" Margin="0,5,0,12"/><TextBlock Text="PORT QUERY (UDP)" Foreground="#B9AEA2" FontSize="11" FontWeight="Bold"/><TextBox x:Name="WizardQueryPortBox" Margin="0,5,0,12"/></StackPanel>
                                            <StackPanel Grid.Column="2"><TextBlock Text="PORT RCON (TCP)" Foreground="#B9AEA2" FontSize="11" FontWeight="Bold"/><TextBox x:Name="WizardRconPortBox" Margin="0,5,0,12"/><TextBlock Text="PORT RUST+ (UDP)" Foreground="#B9AEA2" FontSize="11" FontWeight="Bold"/><TextBox x:Name="WizardAppPortBox" Margin="0,5,0,12"/></StackPanel>
