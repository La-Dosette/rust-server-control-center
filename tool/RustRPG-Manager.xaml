                                            <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><TextBlock Text="Pièces par zombie" VerticalAlignment="Center"/><TextBox x:Name="ZombieKillCoinRewardBox" Grid.Column="1" Text="25"/></Grid>
                                            <Grid Margin="0,0,0,7"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><TextBlock Text="Pièces par vague" VerticalAlignment="Center"/><TextBox x:Name="WaveCoinRewardBox" Grid.Column="1" Text="75"/></Grid>
                                            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><TextBlock Text="Victoire XP / pièces" VerticalAlignment="Center"/><StackPanel Grid.Column="1"><TextBox x:Name="ZombieVictoryXpRewardBox" Text="750" Margin="0,0,0,4"/><TextBox x:Name="ZombieVictoryCoinRewardBox" Text="1500"/></StackPanel></Grid>
                                        </StackPanel>
