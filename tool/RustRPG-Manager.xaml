                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource Panel}" Padding="0" BorderBrush="#5A3A2C">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="64"/></Grid.RowDefinitions>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="215"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                                <Border Grid.Row="0" Grid.Column="0" Background="#13110F" BorderBrush="#40352E" BorderThickness="0,0,1,0">
                                    <StackPanel Margin="24,20">
                                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><Border x:Name="WizardStep1Border" Width="32" Height="32" Background="#D65332" CornerRadius="3"><TextBlock x:Name="WizardStep1Number" Text="1" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Text="PROFIL" VerticalAlignment="Center" FontWeight="Bold"/><TextBlock x:Name="WizardStep1DoneText" Grid.Column="2" Text="" Foreground="#72D79B" VerticalAlignment="Center"/></Grid>
                                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><Border x:Name="WizardStep2Border" Width="32" Height="32" Background="#2A2723" CornerRadius="3"><TextBlock x:Name="WizardStep2Number" Text="2" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9B9288"/></Border><TextBlock Grid.Column="1" Text="RÉSEAU" VerticalAlignment="Center" Foreground="#9B9288"/><TextBlock x:Name="WizardStep2DoneText" Grid.Column="2" Text="" Foreground="#72D79B" VerticalAlignment="Center"/></Grid>
                                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><Border x:Name="WizardStep3Border" Width="32" Height="32" Background="#2A2723" CornerRadius="3"><TextBlock x:Name="WizardStep3Number" Text="3" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9B9288"/></Border><TextBlock Grid.Column="1" Text="CARTE" VerticalAlignment="Center" Foreground="#9B9288"/><TextBlock x:Name="WizardStep3DoneText" Grid.Column="2" Text="" Foreground="#72D79B" VerticalAlignment="Center"/></Grid>
                                        <Grid Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><Border x:Name="WizardStep4Border" Width="32" Height="32" Background="#2A2723" CornerRadius="3"><TextBlock x:Name="WizardStep4Number" Text="4" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9B9288"/></Border><TextBlock Grid.Column="1" Text="PERFORMANCES" VerticalAlignment="Center" Foreground="#9B9288"/><TextBlock x:Name="WizardStep4DoneText" Grid.Column="2" Text="" Foreground="#72D79B" VerticalAlignment="Center"/></Grid>
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/><ColumnDefinition Width="22"/></Grid.ColumnDefinitions><Border x:Name="WizardStep5Border" Width="32" Height="32" Background="#2A2723" CornerRadius="3"><TextBlock x:Name="WizardStep5Number" Text="5" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="#9B9288"/></Border><TextBlock Grid.Column="1" Text="RÉSUMÉ" VerticalAlignment="Center" Foreground="#9B9288"/><TextBlock x:Name="WizardStep5DoneText" Grid.Column="2" Text="" Foreground="#72D79B" VerticalAlignment="Center"/></Grid>
                                    </StackPanel>
                                </Border>

                                <Grid Grid.Row="0" Grid.Column="1" Margin="26,20,26,16">
                                    <StackPanel x:Name="WizardStep1Panel">
                                        <TextBlock Text="QUEL SERVEUR VEUX-TU CRÉER ?" Style="{StaticResource SectionTitle}" Margin="0,0,0,13"/>
                                        <Border x:Name="WizardPresetLocalBorder" BorderBrush="#403A34" BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,0,0,7"><RadioButton x:Name="WizardPresetLocalRadio" GroupName="WizardPreset" Style="{StaticResource WizardRadio}"><StackPanel><TextBlock Text="TEST LOCAL" FontWeight="Bold"/><TextBlock Text="Pour tester seul sur ce PC. Aucun port Internet requis." Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></RadioButton></Border>
                                        <Border x:Name="WizardPresetFriendsBorder" BorderBrush="#D65332" BorderThickness="4,1,1,1" Background="#291913" CornerRadius="3" Padding="11,10" Margin="0,0,0,7"><RadioButton x:Name="WizardPresetFriendsRadio" GroupName="WizardPreset" Style="{StaticResource WizardRadio}" IsChecked="True"><StackPanel><TextBlock Text="ENTRE AMIS" FontWeight="Bold"/><TextBlock Text="Accessible depuis Internet après configuration du routeur." Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></RadioButton></Border>
                                        <Border x:Name="WizardPresetCommunityBorder" BorderBrush="#403A34" BorderThickness="1" CornerRadius="3" Padding="14,10" Margin="0,0,0,13"><RadioButton x:Name="WizardPresetCommunityRadio" GroupName="WizardPreset" Style="{StaticResource WizardRadio}"><StackPanel><TextBlock Text="COMMUNAUTÉ" FontWeight="Bold"/><TextBlock Text="Plus de joueurs, carte plus grande et ressources plus élevées." Style="{StaticResource Muted}" Margin="0,3,0,0"/></StackPanel></RadioButton></Border>
