                                <Border Grid.Column="4" Style="{StaticResource Panel}" Padding="16,13"><StackPanel><TextBlock Text="DISQUE DISPONIBLE" Foreground="#857A6E" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HostHealthDiskText" Text="—" FontSize="25" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
                                <Border Grid.Column="6" Style="{StaticResource Panel}" Padding="16,13" BorderBrush="#6B512D"><StackPanel><TextBlock Text="CAPACITÉ SÛRE" Foreground="#B89462" FontSize="10" FontWeight="Bold"/><TextBlock x:Name="HostHealthCapacityText" Text="—" Foreground="#E7A84D" FontSize="25" FontWeight="Bold" Margin="0,3,0,0"/></StackPanel></Border>
