                                            <Grid Margin="0,0,0,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="95"/></Grid.ColumnDefinitions><TextBlock Text="Pièces victoire" VerticalAlignment="Center"/><TextBox x:Name="ModeCoinRewardBox" Grid.Column="1" Text="1200"/></Grid>
