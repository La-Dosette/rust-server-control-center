                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Config">
                    <Grid Margin="28,24,28,28">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <TextBlock Text="CONFIGURATION" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Editeur visuel typé pour server.cfg, Carbon, modules et plugins, avec source avancée et validation." Grid.Row="1" Style="{StaticResource Muted}" Margin="0,4,0,16"/>
                        <Grid Grid.Row="2" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <ComboBox x:Name="ConfigFileCombo"/>
                            <WrapPanel Grid.Column="1" Margin="10,0,0,0">
                                <Button x:Name="ReloadConfigButton" Content="RECHARGER" Style="{StaticResource SmallButton}" Margin="0,0,8,0"/>
                                <Button x:Name="ValidateConfigButton" Content="VALIDER" Style="{StaticResource SmallButton}" Margin="0,0,8,0"/>
                                <Button x:Name="FormatConfigButton" Content="FORMATER JSON" Style="{StaticResource SmallButton}"/>
                            </WrapPanel>
                        </Grid>
                        <TabControl x:Name="ConfigModeTabs" Grid.Row="3" Background="#12100E" BorderBrush="#3A342D" Foreground="#17130F" Padding="0" SelectedIndex="0">
                            <TabItem Header="ÉDITEUR VISUEL">
                                <Grid Background="#12100E">
                                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                    <Border Background="#211C18" BorderBrush="#3A342D" BorderThickness="0,0,0,1" Padding="12,9">
                                        <TextBlock x:Name="VisualConfigSummaryText" Text="Chargement de la configuration..." Style="{StaticResource Muted}"/>
                                    </Border>
                                    <DataGrid x:Name="VisualConfigGrid" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="False" SelectionMode="Single">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="PARAMÈTRE / CHEMIN" Binding="{Binding Path}" Width="*" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="TYPE" Binding="{Binding Type}" Width="125" IsReadOnly="True"/>
                                            <DataGridTextColumn Header="VALEUR" Binding="{Binding Value, UpdateSourceTrigger=PropertyChanged}" Width="430"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                </Grid>
                            </TabItem>
                            <TabItem Header="SOURCE AVANCÉE">
                                <TextBox x:Name="ConfigEditor" FontFamily="Consolas" FontSize="13" AcceptsReturn="True" AcceptsTab="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" BorderThickness="0"/>
                            </TabItem>
                        </TabControl>
                        <WrapPanel Grid.Row="4" Margin="0,12,0,0"><Button x:Name="SaveConfigButton" Content="VALIDER ET SAUVEGARDER" Style="{StaticResource RustButton}" Margin="0,0,8,0"/><TextBlock Text="Validation avant écriture + copie .bak horodatée automatique." Style="{StaticResource Muted}" VerticalAlignment="Center"/></WrapPanel>
                    </Grid>
                </TabItem>

                <TabItem Header="Rcon">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <Grid Margin="28,24,28,28">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel>
                                <TextBlock Text="JOUEURS &amp; MODÉRATION" Style="{StaticResource PageTitle}"/>
                                <TextBlock Text="Joueurs connectés, sanctions et console RCON." Style="{StaticResource Muted}" Margin="0,5,0,0"/>
                            </StackPanel>

                            <Border Grid.Row="1" Style="{StaticResource Panel}" Margin="0,14,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="JOUEURS CONNECTÉS" Style="{StaticResource SectionTitle}"/>
                                            <TextBlock x:Name="PlayerSummaryText" Text="Serveur arrete." Style="{StaticResource Muted}" Margin="0,4,0,0"/>
                                        </StackPanel>
                                        <Button x:Name="RefreshPlayersButton" Grid.Column="1" Content="ACTUALISER" Style="{StaticResource SmallButton}" VerticalAlignment="Top"/>
                                    </Grid>
                                    <DataGrid x:Name="PlayerGrid" Height="150" Margin="0,12,0,0" AutoGenerateColumns="False">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn Header="Joueur" Binding="{Binding Nom}" Width="*"/>
                                            <DataGridTextColumn Header="SteamID" Binding="{Binding SteamID}" Width="170"/>
                                            <DataGridTextColumn Header="Ping" Binding="{Binding Ping}" Width="60"/>
                                            <DataGridTextColumn Header="Connecté depuis" Binding="{Binding Connecte}" Width="130"/>
                                            <DataGridTextColumn Header="Santé" Binding="{Binding Sante}" Width="60"/>
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock Text="MOTIF OU MESSAGE AU JOUEUR" Foreground="#C8B9A8" FontSize="10" FontWeight="Bold" Margin="0,12,0,4"/>
                                    <TextBox x:Name="ModerationReasonBox" ToolTip="Motif de sanction ou contenu du message privé"/>
                                    <WrapPanel Margin="0,10,0,0">
                                        <Button x:Name="KickPlayerButton" Content="EXPULSER" Style="{StaticResource AmberButton}" Margin="0,0,8,8"/>
                                        <Button x:Name="BanPlayerButton" Content="BANNIR" Style="{StaticResource DangerButton}" Margin="0,0,8,8"/>
                                        <Button x:Name="HealPlayerButton" Content="SOIGNER" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                        <Button x:Name="FreePlayerButton" Content="DÉBLOQUER DU MODE" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                        <Button x:Name="MessagePlayerButton" Content="MESSAGE PRIVÉ" Style="{StaticResource SecondaryButton}" Margin="0,0,8,8"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Grid Grid.Row="2" Margin="0,14,0,0">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <Border Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="JOUEURS BANNIS" Style="{StaticResource SectionTitle}"/>
                                        <DataGrid x:Name="BanGrid" Height="130" Margin="0,10,0,0" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="SteamID" Binding="{Binding SteamID}" Width="170"/>
                                                <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <WrapPanel Margin="0,10,0,0">
                                            <Button x:Name="RefreshBansButton" Content="ACTUALISER" Style="{StaticResource SmallButton}" Margin="0,0,8,0"/>
                                            <Button x:Name="UnbanPlayerButton" Content="DEBANNIR" Style="{StaticResource AmberButton}"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>
                                <Border Grid.Column="2" Style="{StaticResource Panel}">
                                    <StackPanel>
                                        <TextBlock Text="JOURNAL DES SANCTIONS" Style="{StaticResource SectionTitle}"/>
                                        <DataGrid x:Name="ModerationGrid" Height="130" Margin="0,10,0,0" AutoGenerateColumns="False">
                                            <DataGrid.Columns>
                                                <DataGridTextColumn Header="Date" Binding="{Binding Date}" Width="130"/>
                                                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="70"/>
                                                <DataGridTextColumn Header="Joueur" Binding="{Binding Joueur}" Width="*"/>
                                                <DataGridTextColumn Header="Motif" Binding="{Binding Motif}" Width="*"/>
                                            </DataGrid.Columns>
                                        </DataGrid>
                                        <TextBlock Text="Seules les sanctions passees par cet outil y figurent." Style="{StaticResource Muted}" Margin="0,10,0,0"/>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Border Grid.Row="3" Style="{StaticResource Panel}" Margin="0,14,0,0">
                                <StackPanel>
                                    <TextBlock Text="CONSOLE RCON" Style="{StaticResource SectionTitle}"/>
                                    <TextBox x:Name="RconOutput" Height="150" Margin="0,10,0,0" FontFamily="Consolas" FontSize="13" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
                                    <Grid Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="RconCommandBox" ToolTip="Exemple : status, server.save, c.plugins"/><Button x:Name="SendRconButton" Grid.Column="1" Content="ENVOYER" Style="{StaticResource AmberButton}" Margin="10,0,0,0"/></Grid>
                                    <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="BroadcastBox" ToolTip="Message envoyé à tous les joueurs"/><Button x:Name="BroadcastButton" Grid.Column="1" Content="ANNONCE SERVEUR" Style="{StaticResource SecondaryButton}" Margin="10,0,0,0"/></Grid>
                                </StackPanel>
                            </Border>

                            <WrapPanel Grid.Row="4" Margin="0,14,0,0">
                                <Button x:Name="RconSaveButton" Content="SAUVEGARDER LE MONDE" Style="{StaticResource SecondaryButton}"/>
                            </WrapPanel>
                        </Grid>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Stats">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
