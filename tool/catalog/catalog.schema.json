{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Rust Server Control Center plugin catalog",
  "type": "object",
  "required": ["schemaVersion", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "name": { "type": "string" },
    "updatedUtc": { "type": "string" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "version", "fileName"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
          "name": { "type": "string" },
          "description": { "type": "string" },
          "version": { "type": "string" },
          "author": { "type": "string" },
          "category": { "type": "string" },
          "framework": { "enum": ["Carbon", "Any"] },
          "fileName": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+\\.cs$" },
          "downloadUrl": { "type": "string", "pattern": "^https://" },
          "sha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "manifestUrl": { "type": "string", "pattern": "^https://" },
          "manifestSha256": { "type": "string", "pattern": "^[A-Fa-f0-9]{64}$" },
          "bundledManifestPath": { "type": "string", "pattern": "^[A-Za-z0-9_./\\\\-]+\\.json$" },
          "dependencies": { "type": "array", "items": { "type": "string" } },
          "homepage": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  }
}
