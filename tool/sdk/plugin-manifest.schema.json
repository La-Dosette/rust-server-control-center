{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://rust-server-control-center.local/schemas/plugin-manifest-v1.json",
  "title": "Rust Server Control Center plugin manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "plugin", "config", "actions"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
    "plugin": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileBase", "displayName", "version"],
      "properties": {
        "fileBase": { "type": "string", "pattern": "^[A-Za-z0-9_.-]{1,80}$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "version": { "type": "string", "minLength": 1, "maxLength": 32 },
        "category": { "enum": ["mode", "gameplay", "economy", "administration", "utility", "other"] },
        "capabilities": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" } }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fileName", "reloadOnSave", "settings"],
      "properties": {
        "fileName": { "type": "string", "pattern": "^(|[A-Za-z0-9_.-]+\\.json)$" },
        "reloadOnSave": { "type": "boolean" },
        "settings": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "path", "label", "type", "default"],
            "properties": {
              "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
              "path": { "type": "string", "pattern": "^[A-Za-z0-9_-]+(?:\\.[A-Za-z0-9_-]+)*$" },
              "label": { "type": "string", "minLength": 1, "maxLength": 100 },
              "description": { "type": "string", "maxLength": 260 },
              "type": { "enum": ["boolean", "integer", "number", "string", "choice"] },
              "default": {},
              "min": { "type": "number" },
              "max": { "type": "number" },
              "options": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": ["string", "number", "integer"] } }
            }
          }
        }
      }
    },
    "actions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "kind", "command", "confirm"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9_.-]{0,63}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 80 },
          "kind": { "const": "rcon" },
          "command": { "type": "string", "minLength": 1, "maxLength": 180 },
          "confirm": { "type": "boolean" }
        }
      }
    }
  }
}
